# ============================================================
#  FUGU-MAX — قالب المفاتيح. انسخه إلى .env وعبّئه.
#  لا ترفع ملف .env إلى أي مستودع عام.
# ============================================================

# الوضع: demo (الافتراضي) | testnet | live
FUGU_MODE=demo
LIVE_CONFIRM=false

# --- حساب الديمو (demo-fapi.binance.com) — أموال وهمية، آمن للتجارب ---
BINANCE_DEMO_KEY=
BINANCE_DEMO_SECRET=

# --- تيست نت الكلاسيكي (testnet.binancefuture.com) ---
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# --- أموال حقيقية (fapi.binance.com) — لا يُفعّل إلا بـMODE=live و LIVE_CONFIRM=true ---
BINANCE_LIVE_KEY=
BINANCE_LIVE_SECRET=

# --- Telegram (كاشف/مُبلِّغ فقط) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
